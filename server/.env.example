PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/portfolioforge
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional Cloudinary Configuration (set all three; leave all empty for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google Gemini API credentials for AI features (AI endpoints report unavailable when missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
